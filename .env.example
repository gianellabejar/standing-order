# Copy to .env and fill in. Never commit .env. On Vercel, set these in Project Settings > Environment Variables.
# Put comments on their own line: text after a value can end up inside the value.

# --- MongoDB Atlas ---
# Connection string for the hackathon Atlas sandbox cluster (mongodb+srv://...).
MONGODB_URI=
# App database name. Reset only drops databases whose name starts with "orderdesk".
MONGODB_DB=orderdesk

# --- LLM ---
# DeepSeek API key: owner-text parsing, quote extraction, call outcomes, session summaries.
DEEPSEEK_API_KEY=
# DeepSeek model id (ids come from GET /models). Empty = deepseek-flash.
DEEPSEEK_MODEL=
# Backup LLM provider key, for when DeepSeek is down.
FALLBACK_LLM_API_KEY=
# Voyage AI key for memory embeddings (voyage-3.5, 1024 dims) used by Atlas Vector Search.
VOYAGE_API_KEY=

# --- Twilio (SMS) ---
# Twilio account id (starts with AC).
TWILIO_ACCOUNT_SID=
# Twilio auth token: sends SMS and checks X-Twilio-Signature on /sms/inbound (check skipped if empty).
TWILIO_AUTH_TOKEN=
# Our Twilio number (E.164). Owners text it; outbound texts come from it.
TWILIO_PHONE_NUMBER=
# 1 = log outbound texts in audit_events without sending them.
SMS_DRY_RUN=

# --- Team phones and emails (E.164 for phones; never a real business) ---
# Maple Bakery owner's phone; inbound texts from it route to "maple". Empty = fake +15550100001.
OWNER_PHONE_MAPLE=
# Harbour Cafe owner's phone. Must differ from Maple's. Empty = fake +15550100002.
OWNER_PHONE_HARBOUR=
# Maple owner's email; supplier emails they forward to the inbox route to "maple".
OWNER_EMAIL_MAPLE=
# Harbour owner's email; forwarded emails from it route to "harbour".
OWNER_EMAIL_HARBOUR=
# Supplier B's number for real order calls (a teammate playing "Dave").
SUPPLIER_B_PHONE=
# Number the ElevenLabs smoke test calls. Usually the same teammate as SUPPLIER_B_PHONE.
TEST_SUPPLIER_PHONE=

# --- ElevenLabs (voice calls) ---
# ElevenLabs API key (xi-api-key header).
ELEVENLABS_API_KEY=
# The ElevenLabs agent that places supplier calls.
ELEVENLABS_AGENT_ID=
# ElevenLabs id of the imported Twilio number (an id, not a phone number).
ELEVENLABS_PHONE_NUMBER_ID=
# Verifies the signature on the post-call webhook (/voice/post-call).
ELEVENLABS_WEBHOOK_SECRET=
# mock = simulated call (never real); elevenlabs = real call.
VOICE_PROVIDER=mock
# Mock outcome: confirmed, ended_without_number, supplier_asks_question, no_answer.
MOCK_VOICE_SCENARIO=confirmed

# --- Supplier email inbox (IMAP) ---
# IMAP server of the throwaway inbox owners forward supplier emails to.
IMAP_HOST=
# Inbox login (usually the address).
IMAP_USER=
# Inbox password or app password.
IMAP_PASSWORD=
# Required bearer token for GET/POST /ingest/poll (Vercel cron sends it). The route refuses on Vercel without it.
CRON_SECRET=

# --- Web app ---
# Random string that signs the dashboard login cookie. Required on Vercel. Changing it logs everyone out.
SESSION_SECRET=
# Password for the two seeded dashboard logins (the owner emails above). Seed-time only, never committed.
# Without it, `make reset` creates no logins. Everyone who runs a reset needs the same value.
DASHBOARD_SEED_PASSWORD=
# Public HTTPS base URL (Vercel production domain, no trailing slash). Twilio signatures are checked against it.
PUBLIC_BASE_URL=
# Where scripts/sms_sim.py posts. Empty = http://localhost:8000.
SIM_BASE_URL=

# --- Tests ---
# 1 = also run the live DeepSeek extraction test (costs tokens).
RUN_LLM_TESTS=
